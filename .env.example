# Copie este ficheiro para .env e preencha. NUNCA faça commit do .env.
# O comando «flask» lê o .env sozinho (precisa de python-dotenv, que está no requirements.txt).
# Os testes não o leem.

# Obrigatória. Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Domínios aceites no registo, separados por vírgulas (inclui subdomínios).
# Vazio = aceita qualquer email (email pessoal). Exemplo para exigir o institucional: iscap.ipp.pt
ALLOWED_EMAIL_DOMAINS=

# Endereço da área de gestão (administradores). Não aparece em nenhuma página dos alunos.
# Por omissão: /gestao. Mude-o para algo menos óbvio numa instalação real.
# ADMIN_URL_PREFIX=gestao

# Caminho da base de dados SQLite (opcional; por omissão instance/app.sqlite3).
# DATABASE_PATH=instance/app.sqlite3

# LLM da orientação: "falso" (sem rede, por omissão), "gemini" ou "groq" (reserva).
# Experimentar com a chave real: flask --app app llm-teste --backend gemini
LLM_BACKEND=falso
# LLM_MODELO=           # vazio = gemini-3.5-flash-lite (Gemini) ou openai/gpt-oss-120b (Groq)
# Chaves pessoais (https://aistudio.google.com/apikey e https://console.groq.com/keys).
GEMINI_API_KEY=
GROQ_API_KEY=

# Envio de email: "console" (desenvolvimento, escreve no terminal) ou "smtp".
MAIL_BACKEND=console
# Só para MAIL_BACKEND=smtp:
# MAIL_SERVER=smtp.exemplo.pt
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SENDER=noreply@exemplo.pt

# Em produção (HTTPS), ative o cookie seguro.
# SESSION_COOKIE_SECURE=true
