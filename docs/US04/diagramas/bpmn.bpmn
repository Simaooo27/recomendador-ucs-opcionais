<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_US04" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_US04">
    <bpmn:participant id="Participant_US04" name="Catálogo recolhido da DGES (US04)" processRef="Process_US04" />
  </bpmn:collaboration>
  <bpmn:process id="Process_US04" isExecutable="false">
    <bpmn:laneSet id="LaneSet_US04">
      <bpmn:lane id="Lane_US04_0" name="Equipa (script de recolha)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US04_1" name="Sistema (OptaBem)">
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Corre recolher_dges.py descarregar">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Descarregar as páginas dos cursos (1 pedido a cada 2 s)">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Interrompido?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T2" name="Ler as páginas guardadas (processar)">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3" name="Escrever catalogo-cursos.csv, mantendo as descrições do MVP">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Catálogo pronto">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S2" name="A pessoa pede sugestões ao assistente">
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G2" name="Mais de 150 cursos?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T4" name="Perguntar as áreas e enviar só os cursos dessas áreas (máx. 80)">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T5" name="Enviar o catálogo inteiro nas instruções">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E2" name="Sugestão com cursos do catálogo (US30)">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" name="sim: retoma onde parou" sourceRef="G1" targetRef="T1" />
    <bpmn:sequenceFlow id="F4" name="não" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="F5" name="" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F6" name="" sourceRef="T3" targetRef="E1" />
    <bpmn:sequenceFlow id="F7" name="" sourceRef="S2" targetRef="G2" />
    <bpmn:sequenceFlow id="F8" name="sim" sourceRef="G2" targetRef="T4" />
    <bpmn:sequenceFlow id="F9" name="não" sourceRef="G2" targetRef="T5" />
    <bpmn:sequenceFlow id="F10" name="" sourceRef="T4" targetRef="E2" />
    <bpmn:sequenceFlow id="F11" name="" sourceRef="T5" targetRef="E2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_US04">
    <bpmndi:BPMNPlane id="Plane_US04" bpmnElement="Collaboration_US04">
      <bpmndi:BPMNShape id="Participant_US04_di" bpmnElement="Participant_US04" isHorizontal="true"><dc:Bounds x="30" y="20" width="1100" height="600" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US04_0_di" bpmnElement="Lane_US04_0" isHorizontal="true"><dc:Bounds x="60" y="20" width="1070" height="280" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US04_1_di" bpmnElement="Lane_US04_1" isHorizontal="true"><dc:Bounds x="60" y="300" width="1070" height="320" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="132" y="92" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="195" y="78" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="415" y="85" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="535" y="78" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="725" y="78" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="942" y="92" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S2_di" bpmnElement="S2"><dc:Bounds x="132" y="442" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true"><dc:Bounds x="275" y="435" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="425" y="348" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="425" y="513" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="702" y="442" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="168" y="110" /><di:waypoint x="195" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="345" y="110" /><di:waypoint x="415" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="440" y="135" /><di:waypoint x="440" y="215" /><di:waypoint x="270" y="215" /><di:waypoint x="270" y="142" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="465" y="110" /><di:waypoint x="535" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="685" y="110" /><di:waypoint x="725" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="875" y="110" /><di:waypoint x="942" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="168" y="460" /><di:waypoint x="275" y="460" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="300" y="435" /><di:waypoint x="300" y="380" /><di:waypoint x="425" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="300" y="485" /><di:waypoint x="300" y="545" /><di:waypoint x="425" y="545" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="575" y="380" /><di:waypoint x="720" y="380" /><di:waypoint x="720" y="442" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="575" y="545" /><di:waypoint x="720" y="545" /><di:waypoint x="720" y="478" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
