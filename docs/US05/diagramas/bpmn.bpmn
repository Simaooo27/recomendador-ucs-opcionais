<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_US05" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_US05">
    <bpmn:participant id="Participant_US05" name="Consultar e comparar cursos (US05)" processRef="Process_US05" />
  </bpmn:collaboration>
  <bpmn:process id="Process_US05" isExecutable="false">
    <bpmn:laneSet id="LaneSet_US05">
      <bpmn:lane id="Lane_US05_0" name="Pessoa (com ou sem sessão)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US05_1" name="Sistema (OptaBem)">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Abre o catálogo (/cursos/)">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Escolher área, instituição ou localidade e aplicar">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="Filtrar o catálogo com os valores do endereço">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3" name="Mostrar as fichas que correspondem e quantas são">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Comparar ou ver um curso?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T4" name="Marcar 2 ou 3 cursos e carregar em «Comparar»">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="2 ou 3 cursos do catálogo?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T5" name="Mostrar os cursos lado a lado">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Escolhe um curso (US31) ou volta ao catálogo">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T6" name="Avisar: escolha pelo menos 2 cursos">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T7" name="Mostrar a ficha completa: descrição, saídas, dados e fontes">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E2" name="Escolhe o curso (US31) ou compara">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" name="" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" name="" sourceRef="T3" targetRef="G1" />
    <bpmn:sequenceFlow id="F5" name="comparar" sourceRef="G1" targetRef="T4" />
    <bpmn:sequenceFlow id="F6" name="ver um curso" sourceRef="G1" targetRef="T7" />
    <bpmn:sequenceFlow id="F7" name="" sourceRef="T4" targetRef="G2" />
    <bpmn:sequenceFlow id="F8" name="sim" sourceRef="G2" targetRef="T5" />
    <bpmn:sequenceFlow id="F9" name="não" sourceRef="G2" targetRef="T6" />
    <bpmn:sequenceFlow id="F10" name="" sourceRef="T6" targetRef="T4" />
    <bpmn:sequenceFlow id="F11" name="" sourceRef="T5" targetRef="E1" />
    <bpmn:sequenceFlow id="F12" name="" sourceRef="T7" targetRef="E2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_US05">
    <bpmndi:BPMNPlane id="Plane_US05" bpmnElement="Collaboration_US05">
      <bpmndi:BPMNShape id="Participant_US05_di" bpmnElement="Participant_US05" isHorizontal="true"><dc:Bounds x="30" y="20" width="1100" height="600" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US05_0_di" bpmnElement="Lane_US05_0" isHorizontal="true"><dc:Bounds x="60" y="20" width="1070" height="280" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US05_1_di" bpmnElement="Lane_US05_1" isHorizontal="true"><dc:Bounds x="60" y="300" width="1070" height="320" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="112" y="92" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="185" y="78" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="185" y="368" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="375" y="368" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="425" y="185" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="565" y="78" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true"><dc:Bounds x="775" y="375" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="885" y="368" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="942" y="512" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="725" y="513" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T7_di" bpmnElement="T7"><dc:Bounds x="185" y="513" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="122" y="527" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="148" y="110" /><di:waypoint x="185" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="260" y="142" /><di:waypoint x="260" y="368" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="335" y="400" /><di:waypoint x="375" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="450" y="368" /><di:waypoint x="450" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="475" y="210" /><di:waypoint x="640" y="210" /><di:waypoint x="640" y="142" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="425" y="210" /><di:waypoint x="355" y="210" /><di:waypoint x="355" y="545" /><di:waypoint x="335" y="545" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="715" y="110" /><di:waypoint x="800" y="110" /><di:waypoint x="800" y="375" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="825" y="400" /><di:waypoint x="885" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="800" y="425" /><di:waypoint x="800" y="513" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="725" y="545" /><di:waypoint x="690" y="545" /><di:waypoint x="690" y="142" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="960" y="432" /><di:waypoint x="960" y="512" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="185" y="545" /><di:waypoint x="158" y="545" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
