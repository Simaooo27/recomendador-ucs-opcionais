<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_US17" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_US17">
    <bpmn:participant id="Participant_US17" name="Apagar a minha conta (US17)" processRef="Process_US17" />
  </bpmn:collaboration>
  <bpmn:process id="Process_US17" isExecutable="false">
    <bpmn:laneSet id="LaneSet_US17">
      <bpmn:lane id="Lane_US17_0" name="Aluno (com sessão)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US17_1" name="Sistema (OptaBem)">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Em «A minha conta»">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Carregar em «Apagar a minha conta e todos os meus dados»">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="Mostrar o que vai ser apagado e pedir a palavra-passe">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3" name="Escrever a palavra-passe e confirmar">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Palavra-passe certa?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T4" name="Apagar a conta, a conversa, as decisões e os pedidos ao LLM">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T5" name="Terminar a sessão e avisar na página de apresentação">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Conta e dados apagados">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T6" name="Avisar que a palavra-passe não está certa (nada é apagado)">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C1" name="Cancelar e voltar à conta">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E2" name="Nada muda">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" name="" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" name="" sourceRef="T3" targetRef="G1" />
    <bpmn:sequenceFlow id="F5" name="sim" sourceRef="G1" targetRef="T4" />
    <bpmn:sequenceFlow id="F6" name="não" sourceRef="G1" targetRef="T6" />
    <bpmn:sequenceFlow id="F7" name="" sourceRef="T6" targetRef="T3" />
    <bpmn:sequenceFlow id="F8" name="" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F9" name="" sourceRef="T5" targetRef="E1" />
    <bpmn:sequenceFlow id="F10" name="ou" sourceRef="T3" targetRef="C1" />
    <bpmn:sequenceFlow id="F11" name="" sourceRef="C1" targetRef="E2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_US17">
    <bpmndi:BPMNPlane id="Plane_US17" bpmnElement="Collaboration_US17">
      <bpmndi:BPMNShape id="Participant_US17_di" bpmnElement="Participant_US17" isHorizontal="true"><dc:Bounds x="30" y="20" width="1100" height="520" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US17_0_di" bpmnElement="Lane_US17_0" isHorizontal="true"><dc:Bounds x="60" y="20" width="1070" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US17_1_di" bpmnElement="Lane_US17_1" isHorizontal="true"><dc:Bounds x="60" y="260" width="1070" height="280" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="107" y="92" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="185" y="78" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="185" y="348" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="405" y="78" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="455" y="355" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="585" y="348" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="765" y="348" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="952" y="362" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="405" y="448" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C1_di" bpmnElement="C1"><dc:Bounds x="605" y="78" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="822" y="92" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="143" y="110" /><di:waypoint x="185" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="260" y="142" /><di:waypoint x="260" y="348" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="335" y="380" /><di:waypoint x="395" y="380" /><di:waypoint x="395" y="110" /><di:waypoint x="405" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="480" y="142" /><di:waypoint x="480" y="355" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="505" y="380" /><di:waypoint x="585" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="480" y="405" /><di:waypoint x="480" y="448" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="405" y="480" /><di:waypoint x="360" y="480" /><di:waypoint x="360" y="165" /><di:waypoint x="445" y="165" /><di:waypoint x="445" y="142" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="735" y="380" /><di:waypoint x="765" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="915" y="380" /><di:waypoint x="952" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="555" y="110" /><di:waypoint x="605" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="755" y="110" /><di:waypoint x="822" y="110" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
