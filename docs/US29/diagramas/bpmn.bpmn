<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_US29" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_US29">
    <bpmn:participant id="Participant_US29" name="Conversa de orientação (US29)" processRef="Process_US29" />
  </bpmn:collaboration>
  <bpmn:process id="Process_US29" isExecutable="false">
    <bpmn:laneSet id="LaneSet_US29">
      <bpmn:lane id="Lane_US29_0" name="Aluno">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US29_1" name="Sistema (OptaBem)">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US29_2" name="LLM (fornecedor externo)">
        <bpmn:flowNodeRef>L1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Abrir a conversa">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Carregar em «Começar a conversa»">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="Enviar instruções, catálogo e conversa (sem dados pessoais)">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="L1" name="Gerar a próxima pergunta ou a sugestão (JSON)">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Resposta válida?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="TE" name="Mostrar o erro (a conversa fica guardada)">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E2" name="À espera de «Tentar de novo»">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G2" name="Pergunta ou sugestão?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Conversa terminada (cursos na US30)">
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T3" name="Mostrar a pergunta">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T4" name="Escrever a resposta">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T5" name="Validar, apagar emails e números e guardar a resposta">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G3" name="6 respostas?">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T6" name="Exigir a sugestão nas instruções">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" name="" sourceRef="T2" targetRef="L1" />
    <bpmn:sequenceFlow id="F4" name="" sourceRef="L1" targetRef="G1" />
    <bpmn:sequenceFlow id="F5" name="não" sourceRef="G1" targetRef="TE" />
    <bpmn:sequenceFlow id="F6" name="" sourceRef="TE" targetRef="E2" />
    <bpmn:sequenceFlow id="F7" name="sim" sourceRef="G1" targetRef="G2" />
    <bpmn:sequenceFlow id="F8" name="sugestão" sourceRef="G2" targetRef="E1" />
    <bpmn:sequenceFlow id="F9" name="pergunta" sourceRef="G2" targetRef="T3" />
    <bpmn:sequenceFlow id="F10" name="" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F11" name="" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F12" name="" sourceRef="T5" targetRef="G3" />
    <bpmn:sequenceFlow id="F13" name="sim" sourceRef="G3" targetRef="T6" />
    <bpmn:sequenceFlow id="F14" name="" sourceRef="T6" targetRef="T2" />
    <bpmn:sequenceFlow id="F15" name="não" sourceRef="G3" targetRef="T2" />
  </bpmn:process>
