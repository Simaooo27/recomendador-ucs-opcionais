      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="755" y="248" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="755" y="78" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="982" y="92" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="585" y="398" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="812" y="412" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="148" y="110" /><di:waypoint x="215" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="290" y="142" /><di:waypoint x="290" y="248" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="290" y="312" /><di:waypoint x="290" y="573" /></bpmndi:BPMNEdge>
