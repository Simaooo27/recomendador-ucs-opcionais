<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_US30" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_US30">
    <bpmn:participant id="Participant_US30" name="Sugestão de cursos (US30)" processRef="Process_US30" />
  </bpmn:collaboration>
  <bpmn:process id="Process_US30" isExecutable="false">
    <bpmn:laneSet id="LaneSet_US30">
      <bpmn:lane id="Lane_US30_0" name="Aluno">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US30_1" name="Sistema (OptaBem)">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US30_2" name="LLM (fornecedor externo)">
        <bpmn:flowNodeRef>L1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Conversa a decorrer (US29)">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Carregar em «Ver sugestões já» ou dar a 6.ª resposta">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="Exigir a sugestão nas instruções e enviar a conversa">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="L1" name="Escolher 2 a 3 cursos do catálogo e explicar porquê (JSON)">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3" name="Descartar cursos fora do catálogo (RN09) e guardar">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="2 ou mais cursos?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T4" name="Mostrar os cursos: dados do catálogo e explicação">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T5" name="Comparar os cursos sugeridos">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Escolha do curso (US31)">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T6" name="Avisar e propor continuar a conversa ou ver o catálogo">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E2" name="Continua a conversa (US29) ou procura no catálogo">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" name="" sourceRef="T2" targetRef="L1" />
    <bpmn:sequenceFlow id="F4" name="" sourceRef="L1" targetRef="T3" />
    <bpmn:sequenceFlow id="F5" name="" sourceRef="T3" targetRef="G1" />
    <bpmn:sequenceFlow id="F6" name="sim" sourceRef="G1" targetRef="T4" />
    <bpmn:sequenceFlow id="F7" name="não" sourceRef="G1" targetRef="T6" />
    <bpmn:sequenceFlow id="F8" name="" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F9" name="" sourceRef="T5" targetRef="E1" />
    <bpmn:sequenceFlow id="F10" name="" sourceRef="T6" targetRef="E2" />
  </bpmn:process>
