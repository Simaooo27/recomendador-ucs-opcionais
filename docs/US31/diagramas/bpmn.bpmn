<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_US31" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_US31">
    <bpmn:participant id="Participant_US31" name="Escolher curso (US31)" processRef="Process_US31" />
  </bpmn:collaboration>
  <bpmn:process id="Process_US31" isExecutable="false">
    <bpmn:laneSet id="LaneSet_US31">
      <bpmn:lane id="Lane_US31_0" name="Aluno">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US31_1" name="Sistema (OptaBem)">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Vê os cursos sugeridos (US30) ou o catálogo">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Carregar em «Escolher este curso»">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="Mostrar a confirmação (curso atual e aviso sobre a conversa)">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G0" name="Confirma?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E0" name="Volta sem escolher">
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G1" name="Já é o curso atual?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="TE" name="Avisar que já é o seu curso">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E2" name="Sem decisão nova">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T4" name="Registar a decisão: data, sugeridos, escolhido e origem">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T5" name="Apagar a conversa com o LLM (ponto 15)">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T6" name="Mostrar a linha do tempo">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T7" name="Ver as decisões (mais recente primeiro)">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Curso no perfil (RF03)">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" name="" sourceRef="T2" targetRef="G0" />
    <bpmn:sequenceFlow id="F4" name="não" sourceRef="G0" targetRef="E0" />
    <bpmn:sequenceFlow id="F5" name="sim" sourceRef="G0" targetRef="G1" />
    <bpmn:sequenceFlow id="F6" name="sim" sourceRef="G1" targetRef="TE" />
    <bpmn:sequenceFlow id="F7" name="" sourceRef="TE" targetRef="E2" />
    <bpmn:sequenceFlow id="F8" name="não" sourceRef="G1" targetRef="T4" />
    <bpmn:sequenceFlow id="F9" name="" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F10" name="" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="F11" name="" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="F12" name="" sourceRef="T7" targetRef="E1" />
  </bpmn:process>
