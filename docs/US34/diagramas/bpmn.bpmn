<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_US34" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_US34">
    <bpmn:participant id="Participant_US34" name="Registar as minhas notas (US34)" processRef="Process_US34" />
  </bpmn:collaboration>
  <bpmn:process id="Process_US34" isExecutable="false">
    <bpmn:laneSet id="LaneSet_US34">
      <bpmn:lane id="Lane_US34_0" name="Aluno (com sessão)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US34_1" name="Sistema (OptaBem)">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Abre «As minhas notas»">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Indicar a média do secundário e os exames que fez">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="Validar: média de 9,5 a 20; exames de 0 a 200 ou de 0 a 20">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Notas válidas?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T3" name="Ver o erro junto ao campo e corrigir">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T4" name="Converter valores em pontos e guardar no plano">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Vê o plano com as contas feitas">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" name="" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="F4" name="não" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="F5" name="" sourceRef="T3" targetRef="T1" />
    <bpmn:sequenceFlow id="F6" name="sim" sourceRef="G1" targetRef="T4" />
    <bpmn:sequenceFlow id="F7" name="" sourceRef="T4" targetRef="E1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_US34">
    <bpmndi:BPMNPlane id="Plane_US34" bpmnElement="Collaboration_US34">
      <bpmndi:BPMNShape id="Participant_US34_di" bpmnElement="Participant_US34" isHorizontal="true"><dc:Bounds x="30" y="20" width="1000" height="520" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US34_0_di" bpmnElement="Lane_US34_0" isHorizontal="true"><dc:Bounds x="60" y="20" width="970" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US34_1_di" bpmnElement="Lane_US34_1" isHorizontal="true"><dc:Bounds x="60" y="260" width="970" height="280" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="132" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="205" y="88" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="205" y="368" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="445" y="375" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="395" y="168" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="595" y="368" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="852" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="168" y="120" /><di:waypoint x="205" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="280" y="152" /><di:waypoint x="280" y="368" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="355" y="400" /><di:waypoint x="445" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="470" y="375" /><di:waypoint x="470" y="232" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="395" y="200" /><di:waypoint x="380" y="200" /><di:waypoint x="380" y="135" /><di:waypoint x="355" y="135" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="495" y="400" /><di:waypoint x="595" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="745" y="400" /><di:waypoint x="870" y="400" /><di:waypoint x="870" y="138" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
