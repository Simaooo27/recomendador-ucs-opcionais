<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_US37" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_US37">
    <bpmn:participant id="Participant_US37" name="Assistente que conhece as minhas notas (US37)" processRef="Process_US37" />
  </bpmn:collaboration>
  <bpmn:process id="Process_US37" isExecutable="false">
    <bpmn:laneSet id="LaneSet_US37">
      <bpmn:lane id="Lane_US37_0" name="Aluno (com sessão)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US37_1" name="Sistema (OptaBem)">
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US37_2" name="LLM (Gemini)">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Abre a conversa (já indicou exames no plano)">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Marca a caixa (ou não) e carrega em «Começar a conversa»">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Autorizou e tem exames?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T2" name="Tirar os cursos com prova em falta (se sobrarem 10 ou mais)">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3" name="Juntar às instruções os exames feitos e a média num intervalo de 2 valores">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T4" name="Pergunta ou sugere cursos">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T5" name="Validar as sugestões contra o catálogo e assinalar provas em falta">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Vê as perguntas e as sugestões">
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" name="sim" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="F4" name="" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F5" name="" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F6" name="não" sourceRef="G1" targetRef="T4" />
    <bpmn:sequenceFlow id="F7" name="" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F8" name="" sourceRef="T5" targetRef="E1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_US37">
    <bpmndi:BPMNPlane id="Plane_US37" bpmnElement="Collaboration_US37">
      <bpmndi:BPMNShape id="Participant_US37_di" bpmnElement="Participant_US37" isHorizontal="true"><dc:Bounds x="30" y="20" width="1150" height="660" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US37_0_di" bpmnElement="Lane_US37_0" isHorizontal="true"><dc:Bounds x="60" y="20" width="1120" height="210" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US37_1_di" bpmnElement="Lane_US37_1" isHorizontal="true"><dc:Bounds x="60" y="230" width="1120" height="270" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US37_2_di" bpmnElement="Lane_US37_2" isHorizontal="true"><dc:Bounds x="60" y="500" width="1120" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="122" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="225" y="88" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="275" y="345" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="405" y="338" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="595" y="338" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="785" y="558" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="985" y="338" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="1042" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="158" y="120" /><di:waypoint x="225" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="300" y="152" /><di:waypoint x="300" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="325" y="370" /><di:waypoint x="405" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="555" y="370" /><di:waypoint x="595" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="745" y="370" /><di:waypoint x="860" y="370" /><di:waypoint x="860" y="558" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="300" y="395" /><di:waypoint x="300" y="590" /><di:waypoint x="785" y="590" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="935" y="590" /><di:waypoint x="1060" y="590" /><di:waypoint x="1060" y="402" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1060" y="338" /><di:waypoint x="1060" y="138" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
