<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_US39" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_US39">
    <bpmn:participant id="Participant_US39" name="Corrigir e esconder cursos do catálogo (US39)" processRef="Process_US39" />
  </bpmn:collaboration>
  <bpmn:process id="Process_US39" isExecutable="false">
    <bpmn:laneSet id="LaneSet_US39">
      <bpmn:lane id="Lane_US39_0" name="Administrador">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US39_1" name="Sistema (OptaBem)">
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US39_2" name="Aluno ou visitante">
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Abre Gestão › Catálogo">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Procura o curso e abre-o">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="Muda a descrição ou as saídas, ou marca «Esconder»; Guardar">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Mudou alguma coisa?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="«Nada mudou»">
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T3" name="Guardar a correção por cima da DGES e registar quem e quando">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T4" name="O catálogo da aplicação passa a usar a correção (escondido: sai)">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T5" name="Vê o curso corrigido, ou deixa de o ver">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Catálogo corrigido">
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S2" name="Carrega em «Repor os dados da DGES»">
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T6" name="Apagar a correção e registar">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" name="" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="F4" name="não" sourceRef="G1" targetRef="E2" />
    <bpmn:sequenceFlow id="F5" name="sim" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="F6" name="" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F7" name="" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F8" name="" sourceRef="T5" targetRef="E1" />
    <bpmn:sequenceFlow id="F9" name="" sourceRef="S2" targetRef="T6" />
    <bpmn:sequenceFlow id="F10" name="" sourceRef="T6" targetRef="T4" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_US39">
    <bpmndi:BPMNPlane id="Plane_US39" bpmnElement="Collaboration_US39">
      <bpmndi:BPMNShape id="Participant_US39_di" bpmnElement="Participant_US39" isHorizontal="true"><dc:Bounds x="30" y="20" width="1100" height="660" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US39_0_di" bpmnElement="Lane_US39_0" isHorizontal="true"><dc:Bounds x="60" y="20" width="1070" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US39_1_di" bpmnElement="Lane_US39_1" isHorizontal="true"><dc:Bounds x="60" y="240" width="1070" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US39_2_di" bpmnElement="Lane_US39_2" isHorizontal="true"><dc:Bounds x="60" y="500" width="1070" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="132" y="112" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="225" y="98" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="395" y="98" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="445" y="345" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="282" y="352" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="575" y="338" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="765" y="338" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="765" y="558" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="992" y="572" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S2_di" bpmnElement="S2"><dc:Bounds x="1012" y="112" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="955" y="338" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="168" y="130" /><di:waypoint x="225" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="375" y="130" /><di:waypoint x="395" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="470" y="162" /><di:waypoint x="470" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="445" y="370" /><di:waypoint x="318" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="495" y="370" /><di:waypoint x="575" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="725" y="370" /><di:waypoint x="765" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="840" y="402" /><di:waypoint x="840" y="558" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="915" y="590" /><di:waypoint x="992" y="590" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1030" y="148" /><di:waypoint x="1030" y="338" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="955" y="370" /><di:waypoint x="915" y="370" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
