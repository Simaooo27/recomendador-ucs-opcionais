<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_US40" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_US40">
    <bpmn:participant id="Participant_US40" name="Quanto preciso no exame? (US40)" processRef="Process_US40" />
  </bpmn:collaboration>
  <bpmn:process id="Process_US40" isExecutable="false">
    <bpmn:laneSet id="LaneSet_US40">
      <bpmn:lane id="Lane_US40_0" name="Aluno (com sessão)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US40_1" name="Sistema (OptaBem)">
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Abre a ficha de um curso (ou o plano)">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Ler a média, os exames feitos e as condições do curso">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Tem média e falta alguma prova?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E3" name="Só a nota (US35)">
      <bpmn:incoming>F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T2" name="Alvo: último colocado (ou nota mínima do curso)">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3" name="Em cada conjunto, nota precisa nas provas em falta, com o mínimo">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T4" name="Ficar com o conjunto em que é mais fácil">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="Chega com 200 ou menos?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T5" name="Dizer que nem 200 chegam e a nota máxima possível">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Vê «precisa de X em Y»">
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E2" name="Sabe que não chega">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" name="não" sourceRef="G1" targetRef="E3" />
    <bpmn:sequenceFlow id="F4" name="sim" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="F5" name="" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F6" name="" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F7" name="" sourceRef="T4" targetRef="G2" />
    <bpmn:sequenceFlow id="F8" name="sim" sourceRef="G2" targetRef="E1" />
    <bpmn:sequenceFlow id="F9" name="não" sourceRef="G2" targetRef="T5" />
    <bpmn:sequenceFlow id="F10" name="" sourceRef="T5" targetRef="E2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_US40">
    <bpmndi:BPMNPlane id="Plane_US40" bpmnElement="Collaboration_US40">
      <bpmndi:BPMNShape id="Participant_US40_di" bpmnElement="Participant_US40" isHorizontal="true"><dc:Bounds x="30" y="20" width="1100" height="600" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US40_0_di" bpmnElement="Lane_US40_0" isHorizontal="true"><dc:Bounds x="60" y="20" width="1070" height="200" /></bpmndi:BPMNShape>
