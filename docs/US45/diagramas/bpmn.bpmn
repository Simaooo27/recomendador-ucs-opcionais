<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_US45" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_US45">
    <bpmn:participant id="Participant_US45" name="Plano B: 2.ª fase (US45)" processRef="Process_US45" />
  </bpmn:collaboration>
  <bpmn:process id="Process_US45" isExecutable="false">
    <bpmn:laneSet id="LaneSet_US45">
      <bpmn:lane id="Lane_US45_0" name="Aluno (com sessão)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US45_1" name="Sistema (OptaBem)">
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Abre o plano de candidatura">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G1" name="Tem notas e opções?">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Sem plano B">
      <bpmn:incoming>F2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T1" name="Procurar cursos das mesmas áreas, fora do plano, com vagas na 2.ª fase de 2025">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="Algum a que a nota chegava?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T2" name="Mostrar até 3, os mais disputados primeiro, com o aviso das vagas">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3" name="Explicar porque ainda não há plano B">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Tem uma alternativa para a 2.ª fase">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E3" name="Sabe que não há">
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="G1" />
    <bpmn:sequenceFlow id="F2" name="não" sourceRef="G1" targetRef="E2" />
    <bpmn:sequenceFlow id="F3" name="sim" sourceRef="G1" targetRef="T1" />
    <bpmn:sequenceFlow id="F4" name="" sourceRef="T1" targetRef="G2" />
    <bpmn:sequenceFlow id="F5" name="sim" sourceRef="G2" targetRef="T2" />
    <bpmn:sequenceFlow id="F6" name="não" sourceRef="G2" targetRef="T3" />
    <bpmn:sequenceFlow id="F7" name="" sourceRef="T2" targetRef="E1" />
    <bpmn:sequenceFlow id="F8" name="" sourceRef="T3" targetRef="E3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_US45">
    <bpmndi:BPMNPlane id="Plane_US45" bpmnElement="Collaboration_US45">
      <bpmndi:BPMNShape id="Participant_US45_di" bpmnElement="Participant_US45" isHorizontal="true"><dc:Bounds x="30" y="20" width="1100" height="600" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US45_0_di" bpmnElement="Lane_US45_0" isHorizontal="true"><dc:Bounds x="60" y="20" width="1070" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US45_1_di" bpmnElement="Lane_US45_1" isHorizontal="true"><dc:Bounds x="60" y="220" width="1070" height="400" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="132" y="92" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="275" y="305" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="282" y="482" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="405" y="298" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true"><dc:Bounds x="635" y="305" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="785" y="298" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="585" y="488" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="842" y="92" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E3_di" bpmnElement="E3"><dc:Bounds x="842" y="502" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="150" y="128" /><di:waypoint x="150" y="330" /><di:waypoint x="275" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="300" y="355" /><di:waypoint x="300" y="482" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="325" y="330" /><di:waypoint x="405" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="555" y="330" /><di:waypoint x="635" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="685" y="330" /><di:waypoint x="785" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="660" y="355" /><di:waypoint x="660" y="488" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="860" y="298" /><di:waypoint x="860" y="128" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="735" y="520" /><di:waypoint x="842" y="520" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
