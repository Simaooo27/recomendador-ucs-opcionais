<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_US46" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_US46">
    <bpmn:participant id="Participant_US46" name="Exportar os meus dados (US46)" processRef="Process_US46" />
  </bpmn:collaboration>
  <bpmn:process id="Process_US46" isExecutable="false">
    <bpmn:laneSet id="LaneSet_US46">
      <bpmn:lane id="Lane_US46_0" name="Aluno (com sessão)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US46_1" name="Sistema (OptaBem)">
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Abre «Descarregar os meus dados» em «A minha conta»">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Escreve a palavra-passe e carrega em «Descarregar»">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Palavra-passe certa?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Vê o erro; nada é descarregado">
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T2" name="Juntar conta, decisões, plano, conversa e pedidos, só deste aluno">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3" name="Devolver um ficheiro JSON, sem palavra-passe nem código de partilha">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Recebe o ficheiro">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" name="sim" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="F4" name="não" sourceRef="G1" targetRef="E2" />
    <bpmn:sequenceFlow id="F5" name="" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F6" name="" sourceRef="T3" targetRef="E1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_US46">
    <bpmndi:BPMNPlane id="Plane_US46" bpmnElement="Collaboration_US46">
      <bpmndi:BPMNShape id="Participant_US46_di" bpmnElement="Participant_US46" isHorizontal="true"><dc:Bounds x="30" y="20" width="1100" height="520" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US46_0_di" bpmnElement="Lane_US46_0" isHorizontal="true"><dc:Bounds x="60" y="20" width="1070" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_US46_1_di" bpmnElement="Lane_US46_1" isHorizontal="true"><dc:Bounds x="60" y="260" width="1070" height="280" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="132" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="245" y="108" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="475" y="375" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="482" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="625" y="368" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="825" y="368" width="150" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="1042" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="168" y="140" /><di:waypoint x="245" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="320" y="172" /><di:waypoint x="320" y="400" /><di:waypoint x="475" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="525" y="400" /><di:waypoint x="625" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="500" y="375" /><di:waypoint x="500" y="158" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="775" y="400" /><di:waypoint x="825" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="900" y="368" /><di:waypoint x="900" y="140" /><di:waypoint x="1042" y="140" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
